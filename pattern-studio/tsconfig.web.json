{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "noEmit": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "resolveJsonModule": true
  },
  "include": ["web/**/*.ts", "src/index.ts", "src/**/*.d.ts"]
}
