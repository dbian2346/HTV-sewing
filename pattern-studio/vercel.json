{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:ui",
  "outputDirectory": "out",
  "functions": {
    "api/*.mjs": {
      "includeFiles": [
        "src/**",
        "server/**",
        "engines/**",
        "*.json"
      ],
      "maxDuration": 120
    }
  }
}
