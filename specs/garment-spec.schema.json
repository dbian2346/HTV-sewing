{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:garment-pattern-spec:2",
  "title": "Versioned garment pattern request v2",
  "description": "Canonical application input. Design-specific options are converted to FreeSewing settings by map-to-freesewing.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "measurementSystem",
    "garment",
    "measurements",
    "options",
    "construction",
    "render",
    "print"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "measurementSystem": {
      "const": "metric"
    },
    "garment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "designId",
        "family",
        "name"
      ],
      "properties": {
        "designId": {
          "enum": [
            "penelope",
            "titan",
            "teagan",
            "simon",
            "sophie",
            "carlita"
          ]
        },
        "family": {
          "enum": [
            "skirt",
            "trousers",
            "knitTop",
            "shirt",
            "dress",
            "coat"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ankle": {
          "type": "number",
          "minimum": 1,
          "maximum": 3000
        },
        "biceps": {
          "type": "number",
          "minimum": 1,
          "maximum": 3000
        },
        "bustFront": {
          "type": "number",
          "minimum": 1,
          "maximum": 3000
        },
        "bustPointToUnderbust": {
          "type": "number",
          "minimum": 1,
          "maximum": 3000
        },
        "bustSpan": {
          "type": "number",
          "minimum": 1,
          "maximum": 3000
        },
        "chest": {
          "type": "number",
          "minimum": 1,
          "maximum": 3000
        },
        "crossSeam": {
          "type": "number",
          "minimum": 1,
          "maximum": 3000
        },
        "crossSeamFront": {
          "type": "number",
          "minimum": 1,
          "maximum": 3000
        },
        "crotchDepth": {
          "type": "number",
          "minimum": 1,
          "maximum": 3000
        },
        "head": {
          "type": "number",
          "minimum": 1,
          "maximum": 3000
        },
        "heel": {
          "type": "number",
          "minimum": 1,
          "maximum": 3000
        },
        "highBust": {
          "type": "number",
          "minimum": 1,
          "maximum": 3000
        },
        "highBustFront": {
          "type": "number",
          "minimum": 1,
          "maximum": 3000
        },
        "hips": {
          "type": "number",
          "minimum": 1,
          "maximum": 3000
        },
        "hpsToBust": {
          "type": "number",
          "minimum": 1,
          "maximum": 3000
        },
        "hpsToWaistBack": {
          "type": "number",
          "minimum": 1,
          "maximum": 3000
        },
        "hpsToWaistFront": {
          "type": "number",
          "minimum": 1,
          "maximum": 3000
        },
        "inseam": {
          "type": "number",
          "minimum": 1,
          "maximum": 3000
        },
        "knee": {
          "type": "number",
          "minimum": 1,
          "maximum": 3000
        },
        "neck": {
          "type": "number",
          "minimum": 1,
          "maximum": 3000
        },
        "seat": {
          "type": "number",
          "minimum": 1,
          "maximum": 3000
        },
        "seatBack": {
          "type": "number",
          "minimum": 1,
          "maximum": 3000
        },
        "shoulderSlope": {
          "type": "number",
          "minimum": 0,
          "maximum": 60
        },
        "shoulderToElbow": {
          "type": "number",
          "minimum": 1,
          "maximum": 3000
        },
        "shoulderToShoulder": {
          "type": "number",
          "minimum": 1,
          "maximum": 3000
        },
        "shoulderToWrist": {
          "type": "number",
          "minimum": 1,
          "maximum": 3000
        },
        "underbust": {
          "type": "number",
          "minimum": 1,
          "maximum": 3000
        },
        "upperLeg": {
          "type": "number",
          "minimum": 1,
          "maximum": 3000
        },
        "waist": {
          "type": "number",
          "minimum": 1,
          "maximum": 3000
        },
        "waistBack": {
          "type": "number",
          "minimum": 1,
          "maximum": 3000
        },
        "waistToArmpit": {
          "type": "number",
          "minimum": 1,
          "maximum": 3000
        },
        "waistToFloor": {
          "type": "number",
          "minimum": 1,
          "maximum": 3000
        },
        "waistToHips": {
          "type": "number",
          "minimum": 1,
          "maximum": 3000
        },
        "waistToKnee": {
          "type": "number",
          "minimum": 1,
          "maximum": 3000
        },
        "waistToSeat": {
          "type": "number",
          "minimum": 1,
          "maximum": 3000
        },
        "waistToUnderbust": {
          "type": "number",
          "minimum": 1,
          "maximum": 3000
        },
        "waistToUpperLeg": {
          "type": "number",
          "minimum": 1,
          "maximum": 3000
        },
        "wrist": {
          "type": "number",
          "minimum": 1,
          "maximum": 3000
        }
      }
    },
    "options": {
      "type": "object"
    },
    "construction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seamAllowanceMm"
      ],
      "properties": {
        "seamAllowanceMm": {
          "type": "number",
          "minimum": 0,
          "maximum": 30
        }
      }
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete",
        "paperless"
      ],
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "paperless": {
          "type": "boolean"
        }
      }
    },
    "print": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paper",
        "marginMm",
        "overlapMm",
        "calibrationSquareMm"
      ],
      "properties": {
        "paper": {
          "enum": [
            "A4",
            "Letter"
          ]
        },
        "marginMm": {
          "type": "number",
          "minimum": 5,
          "maximum": 25
        },
        "overlapMm": {
          "type": "number",
          "minimum": 0,
          "maximum": 30
        },
        "calibrationSquareMm": {
          "const": 50
        }
      }
    },
    "fabric": {
      "description": "Metadata for downstream fabric planning; not passed to FreeSewing by this adapter.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "structure": {
          "enum": [
            "woven",
            "knit",
            "unknown"
          ]
        },
        "stretchPct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "shrinkagePct": {
          "type": "number",
          "minimum": 0,
          "maximum": 30
        },
        "directionalPrint": {
          "type": "boolean"
        }
      }
    }
  },
  "oneOf": [
    {
      "title": "penelope settings",
      "properties": {
        "garment": {
